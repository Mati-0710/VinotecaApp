@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - EMPATIA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #121212; color: #f4ece4; display: flex; align-items: center; justify-content: center; height: 100vh; font-family: 'Montserrat', sans-serif; }
        .login-card { background-color: #1e1e1e; padding: 40px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); width: 100%; max-width: 400px; border-top: 4px solid #d07a38; }
        .btn-madera { background-color: #d07a38; color: #121212; font-weight: bold; }
        .btn-madera:hover { background-color: #b06225; color: #fff; }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <h2 class="mb-4" style="font-family: 'Playfair Display', serif; color: #d07a38;">EMPATIA</h2>
        <p class="text-muted mb-4">Acceso al Sistema</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-action="Login" method="post">
            <div class="form-floating mb-3">
                <input type="text" class="form-control bg-dark text-white border-secondary" id="usuario" name="usuario" placeholder="Usuario" required>
                <label for="usuario" class="text-muted">Usuario</label>
            </div>
            <div class="form-floating mb-4">
                <input type="password" class="form-control bg-dark text-white border-secondary" id="password" name="password" placeholder="Contraseña" required>
                <label for="password" class="text-muted">Contraseña</label>
            </div>
            <button type="submit" class="btn btn-madera w-100 py-2">Ingresar</button>
        </form>
    </div>
</body>
</html>