@model IEnumerable<VinotecaApp.Models.Bodega>

@{
    ViewData["Title"] = "Bodegas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Bodegas</h1>
    <a asp-action="Create" class="btn btn-primary">Nueva Bodega</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Nombre de la Bodega</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bodega in Model)
                {
                    <tr>
                        <td class="ps-3">@bodega.Nombre</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>