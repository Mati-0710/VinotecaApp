@model IEnumerable<VinotecaApp.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<h1>Clientes</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Cliente</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>DNI/CUIT</th>
            <th>Teléfono</th>
            <th>Email</th>
            <th>Dirección</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="ps-4 py-3 fw-semibold text-dark">@item.Nombre</td>
                <td class="py-3 fw-semibold text-dark">@item.Apellido</td>
                <td class="py-3">@(string.IsNullOrEmpty(item.DniCuit) ? "-" : item.DniCuit)</td>
                <td class="py-3">@(string.IsNullOrEmpty(item.Telefono) ? "-" : item.Telefono)</td>
                <td class="py-3 text-muted">@(string.IsNullOrEmpty(item.Email) ? "-" : item.Email)</td>
                <td class="py-3 text-muted text-truncate" style="max-width: 150px;">
                    @(string.IsNullOrEmpty(item.Direccion) ? "-" : item.Direccion)
                </td>
                <td class="text-end pe-4 py-3">
                    @if (!item.EsConsumidorFinal)
                    {
                        <!-- Botones para clientes normales -->
                        <div class="btn-group shadow-sm">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm"
                               title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm"
                               title="Detalles">
                                <i class="bi bi-info-circle"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm"
                               title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    }
                    else
                    {
                        <!-- Candado visual para el Consumidor Final -->
                        <span class="badge bg-light text-secondary border px-2 py-1" style="border-radius: 4px;">
                            <i class="bi bi-lock-fill me-1"></i>Sistema
                        </span>
                    }
                </td>
            </tr>
        }
        
    </tbody>
</table>