@{
    Layout = null; // Esto apaga la barra de Leandro
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EMPATIA wines</title>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Iconos y Tipografías -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --color-fondo: #121212;
            --color-madera: #d07a38; 
            --color-texto: #f4ece4;
            --color-oscuro-secundario: #1e1e1e;
        }

        body {
            background-color: var(--color-fondo);
            color: var(--color-texto);
            font-family: 'Montserrat', sans-serif;
        }

        h1, h2, h3, .fuente-titulo {
            font-family: 'Playfair Display', serif;
        }

        .hero-section {
            position: relative;
            height: 80vh;
            background: url('https://images.unsplash.com/photo-1582585434685-64bc6808770c?q=80&w=1920&auto=format&fit=crop') no-repeat center center;
            background-size: cover;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .hero-overlay {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(rgba(18, 18, 18, 0.7), rgba(18, 18, 18, 0.95));
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-title {
            font-size: 4rem;
            letter-spacing: 2px;
            color: var(--color-madera);
        }

        .btn-madera {
            background-color: var(--color-madera);
            color: var(--color-fondo);
            font-weight: bold;
            border-radius: 0;
            padding: 12px 30px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-madera:hover {
            background-color: #b06225;
            color: #fff;
        }

        .categoria-card {
            background-color: var(--color-oscuro-secundario);
            border: 1px solid #333;
            transition: transform 0.3s ease;
        }
        
        .categoria-card:hover {
            transform: translateY(-5px);
            border-color: var(--color-madera);
        }

        .whatsapp-flotante {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background-color: #25D366;
            color: white;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            z-index: 1000;
            text-decoration: none;
        }
        .whatsapp-flotante:hover {
            color: white;
            background-color: #1ebe57;
        }
    </style>
</head>
<body>

    <section class="hero-section">
        <div class="hero-overlay"></div>
        <div class="hero-content container">
            <h1 class="hero-title mb-3">EMPATIA</h1>
            <p class="fs-4 mb-4">w i n e s</p>
            <p class="lead mb-5 mx-auto" style="max-width: 600px;">
                Selección exclusiva de etiquetas y atención personalizada. Descubrí el vino perfecto para cada momento.
            </p>
            <a href="https://wa.me/TUNUMERODEWHATSAPP" target="_blank" class="btn btn-madera btn-lg shadow-sm">
                Consultar catálogo por WhatsApp
            </a>
        </div>
    </section>

    <section class="container py-5 my-5 text-center">
        <h2 class="mb-4" style="color: var(--color-madera);">Filosofía Empatía</h2>
        <div class="mx-auto" style="max-width: 800px; line-height: 1.8;">
            <p>
                No somos solo un lugar donde comprar vinos. Creemos en escuchar, recomendar y acompañar. Nuestro objetivo es que te lleves la botella exacta que estás buscando, ya sea para una cena especial, un regalo empresarial o simplemente para disfrutar en casa.
            </p>
        </div>
    </section>

    <section class="container mb-5 pb-5">
        <h3 class="text-center mb-5" style="color: var(--color-madera);">Nuestra Selección</h3>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card categoria-card h-100 text-center">
                    <img src="https://images.unsplash.com/photo-1506377247377-2a5b3b417ebb?q=80&w=600&auto=format&fit=crop" class="card-img-top opacity-75" alt="Vinos de Autor">
                    <div class="card-body py-4">
                        <h4 class="card-title fuente-titulo">Vinos de Autor</h4>
                        <p class="card-text text-muted small">Bodegas boutique y partidas limitadas.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card categoria-card h-100 text-center">
                    <img src="https://images.unsplash.com/photo-1572914857317-a02d84711f58?q=80&w=600&auto=format&fit=crop" class="card-img-top opacity-75" alt="Alta Gama">
                    <div class="card-body py-4">
                        <h4 class="card-title fuente-titulo">Alta Gama</h4>
                        <p class="card-text text-muted small">Etiquetas consagradas para paladares exigentes.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card categoria-card h-100 text-center">
                    <img src="https://images.unsplash.com/photo-1590595978583-382956f71dcb?q=80&w=600&auto=format&fit=crop" class="card-img-top opacity-75" alt="Espumantes">
                    <div class="card-body py-4">
                        <h4 class="card-title fuente-titulo">Espumantes & Destilados</h4>
                        <p class="card-text text-muted small">Para brindar y celebrar ocasiones únicas.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer class="text-center py-5" style="background-color: #0a0a0a;">
        <h4 class="fuente-titulo mb-3" style="color: var(--color-madera);">EMPATIA wines</h4>
        <p class="mb-1">Villa Cañás, Santa Fe</p>
        <p class="text-muted small mb-4">Lunes a Sábados</p>
        <a href="https://www.instagram.com/empatiawines/?hl=es" target="_blank" class="text-white text-decoration-none mx-2 fs-5">
            <i class="bi bi-instagram"></i> Seguinos en Instagram
        </a>
    </footer>

    <a href="https://wa.me/TUNUMERODEWHATSAPP" target="_blank" class="whatsapp-flotante">
        <i class="bi bi-whatsapp"></i>
    </a>

    <!-- Scripts de Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.css"></script>
</body>
</html>