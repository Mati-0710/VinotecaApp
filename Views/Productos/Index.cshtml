@model IEnumerable<VinotecaApp.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    var categorias = (List<VinotecaApp.Models.Categoria>)ViewBag.Categorias;
    int? categoriaSeleccionada = ViewBag.CategoriaSeleccionada;
}

<h1>Productos</h1>

<div class="row mb-3 align-items-end">
    <div class="col-md-10">
        <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap">
            
            <!-- Buscador por texto -->
            <div style="min-width: 220px;" class="flex-grow-1">
                <label class="form-label">Buscar producto</label>
                <div class="input-group">
                    <input type="text" name="buscar" class="form-control" placeholder="Ej: Malbec, Rutini..." value="@ViewBag.Buscar">
                    <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                </div>
            </div>

            <!-- Filtro por Categoría / Subcategoría -->
            <div>
                <label class="form-label">Categoría / Variedad</label>
                <select name="categoriaId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todas --</option>
                    @{
                        var categorias = ViewBag.Categorias as List<VinotecaApp.Models.Categoria>;
                        var padres = categorias != null ? categorias.Where(c => c.CategoriaPadreId == null).OrderBy(c => c.Nombre) : Enumerable.Empty<VinotecaApp.Models.Categoria>();
                    }
                    @foreach (var padre in padres)
                    {
                        <option value="@padre.Id" selected="@(ViewBag.CategoriaSeleccionada == padre.Id)">
                            @padre.Nombre
                        </option>
                        
                        var hijas = categorias != null ? categorias.Where(c => c.CategoriaPadreId == padre.Id).OrderBy(c => c.Nombre) : Enumerable.Empty<VinotecaApp.Models.Categoria>();
                        foreach (var hija in hijas)
                        {
                            <option value="@hija.Id" selected="@(ViewBag.CategoriaSeleccionada == hija.Id)">
                                &nbsp;&nbsp;&nbsp;— @hija.Nombre
                            </option>
                        }
                    }
                        
                       }
                </select>
            </div>

            <!-- Filtro por Bodega -->
            <div>
                <label class="form-label">Bodega</label>
                <select name="bodegaId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todas las Bodegas --</option>
                    @foreach (var bodega in (List<VinotecaApp.Models.Bodega>)ViewBag.Bodegas)
                    {
                        <option value="@bodega.Id" selected="@(ViewBag.BodegaSeleccionada == bodega.Id)">
                            @bodega.Nombre
                        </option>
                    }
                </select>
            </div>
            
            <!-- Botón para limpiar filtros -->
            <div>
                <label class="form-label d-block">&nbsp;</label>
                <a asp-action="Index" class="btn btn-light border" title="Limpiar filtros">Limpiar</a>
            </div>
            
        </form>
    </div>

    <div class="col-md-2 text-md-end mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary w-100">Nuevo Producto</a>
    </div>
</div>

<!-- En la tabla de productos, asegurate de mostrar la columna de Bodega -->
<table class="table table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Bodega</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.Nombre</td>
                <td>@(item.Categoria != null ? item.Categoria.Nombre : "-")</td>
                <td>@(item.Bodega != null ? item.Bodega.Nombre : "-")</td> <!-- Mostramos la bodega -->
                <td>$ @item.Precio.ToString("N0")</td>
                <td>@item.Stock</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                </td>
            </tr>
        }
    </tbody>
</table>