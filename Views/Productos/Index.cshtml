@model IEnumerable<VinotecaApp.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    var categorias = (List<VinotecaApp.Models.Categoria>)ViewBag.Categorias;
    int? categoriaSeleccionada = ViewBag.CategoriaSeleccionada;
}

<h1>Productos</h1>

<div class="row mb-3 align-items-end">
    <div class="col-md-8">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            
            <!-- Buscador por texto -->
            <div class="flex-grow-1">
                <label class="form-label">Buscar producto</label>
                <div class="input-group">
                    <input type="text" name="buscar" class="form-control" placeholder="Ej: Rutini, Malbec, Copa..." value="@ViewBag.Buscar">
                    <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                </div>
            </div>

            <!-- Filtro por categoría -->
            <!-- Filtro por categoría -->
            <div>
                <label class="form-label">Categoría</label>
                <select name="categoriaId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Todas --</option>
                    @{
                        var categorias = ViewBag.Categorias as List<VinotecaApp.Models.Categoria>;
                        var padres = categorias.Where(c => c.CategoriaPadreId == null).OrderBy(c => c.Nombre);
                    }
                    @foreach (var padre in padres)
                    {
                        <option value="@padre.Id" selected="@(ViewBag.CategoriaSeleccionada == padre.Id)">
                            @padre.Nombre
                        </option>
                        
                        var hijas = categorias.Where(c => c.CategoriaPadreId == padre.Id).OrderBy(c => c.Nombre);
                        foreach (var hija in hijas)
                        {
                            <option value="@hija.Id" selected="@(ViewBag.CategoriaSeleccionada == hija.Id)">
                                &nbsp;&nbsp;&nbsp;— @hija.Nombre
                            </option>
                        }
                    }
                </select>
            </div>
            
            <!-- Botón para limpiar los filtros -->
            <div>
                <label class="form-label d-block">&nbsp;</label>
                <a asp-action="Index" class="btn btn-light" title="Limpiar filtros">Limpiar</a>
            </div>
            
        </form>
    </div>

    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary">Nuevo Producto</a>
    </div>
</div>
<table class="table table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Stock</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@(item.Categoria != null ? item.Categoria.Nombre : "-")</td>
                <td>@item.Precio.ToString("C")</td>
                <td>@item.Stock</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>