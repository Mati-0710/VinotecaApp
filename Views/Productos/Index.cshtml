@model IEnumerable<VinotecaApp.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="panel-admin mt-4">
    <!-- Encabezado con tipografía de la marca y botón dorado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="admin-title mb-0">Catálogo de Productos</h1>
        <a asp-action="Create" class="btn btn-dorado fw-bold px-4 py-2 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
        </a>
    </div>

    <!-- Buscador y Filtros -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 4px;">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="buscar" class="form-control border-start-0" placeholder="Buscar por nombre, bodega o varietal..." value="@ViewBag.BusquedaActual">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100" style="border-radius: 4px;">Buscar</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100" style="border-radius: 4px;">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Contenedor con fondo crema y bordes rectos/suaves -->
    <div class="card shadow-sm border-0" style="border-radius: 4px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 tabla-vino">
                    <thead>
                        <tr>
                            <th class="ps-4 py-3 fw-semibold">Producto</th>
                            <th class="py-3 fw-semibold">Categoría / Varietal</th>
                            <th class="py-3 fw-semibold text-end">Precio</th>
                            <th class="py-3 fw-semibold text-center">Stock</th>
                            <th class="text-end pe-4 py-3 fw-semibold">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <!-- Doble línea: Nombre principal y abajo la Bodega con Cosecha -->
                                    <div class="fw-semibold text-dark">@item.Nombre</div>
                                    <div class="text-muted" style="font-size: 0.8rem;">
                                        @(item.Bodega?.Nombre ?? "Sin bodega") 
                                        @if (item.Cosecha.HasValue)
                                        {
                                            <span class="ms-1 badge bg-transparent text-secondary border">@(item.Cosecha)</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <!-- Categoría como texto neutro refinado -->
                                    <span class="text-secondary fw-medium text-uppercase"
                                          style="font-size: 0.82rem; letter-spacing: 0.5px;">
                                        @(item.Categoria?.Nombre ?? "-")
                                    </span>
                                </td>
                                <td class="fw-medium text-dark text-end">
                                    $@item.Precio.ToString("N0")
                                </td>
                                <td class="text-center">
                                    @if (item.Stock == 0)
                                    {
                                        <!-- Sin stock -->
                                        <span class="text-danger fw-bold">
                                            <i class="bi bi-x-circle me-1"></i>0
                                        </span>
                                    }
                                    else if (item.Stock <= 6)
                                    {
                                        <!-- Stock bajo (Alerta naranja) -->
                                        <span class="fw-bold" style="color: #d97706;">
                                            <i class="bi bi-exclamation-triangle me-1"></i>@item.Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <!-- Stock normal -->
                                        <span class="text-success fw-bold">
                                            <i class="bi bi-check2 me-1"></i>@item.Stock
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <!-- Botones de acción limpios -->
                                    <div class="btn-group shadow-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-secondary btn-sm" title="Editar">
                                            Editar
                                        </a>
                                        
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de que querés ocultar este producto del catálogo?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar" style="border-top-left-radius: 0; border-bottom-left-radius: 0;">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>