@model VinotecaApp.Models.Pago

@{
    ViewData["Title"] = "Nuevo Pago";
}

<h1>Registrar Pago</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create" method="post">
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Cliente</label>
            <select asp-for="ClienteId" asp-items="@(new SelectList(ViewBag.Clientes, "Id", "NombreCompleto"))" class="form-select">
                <option value="">-- Seleccionar --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Monto</label>
            <input asp-for="Monto" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Medio de Pago</label>
            <select asp-for="MedioPago" class="form-select">
                <option value="Efectivo">Efectivo</option>
                <option value="Transferencia">Transferencia</option>
                <option value="Tarjeta">Tarjeta</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Registrar Pago</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>