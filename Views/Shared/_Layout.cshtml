<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VinotecaApp</title>
    <script type="importmap"></script>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VinotecaApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vinoteca.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                     <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                         <path d="M7 2C7 2 6 6 6 9C6 11.5 8 13 11 13.5V19H8V21H16V19H13V13.5C16 13 18 11.5 18 9C18 6 17 2 17 2H7Z"  stroke="#C9A66B" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
                     </svg> VinotecaApp
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                             <a class="nav-link text-dark" asp-area="" asp-controller="Ventas" asp-action="Index">Ventas</a>
                         </li>
                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="CuentasCorrientes" asp-action="Index">Cuentas Corrientes</a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Productos" asp-action="Index">Productos</a>
                         </li>
                        
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarAltas" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-journal-plus me-1"></i>Registros
                            </a>
                                <ul class="dropdown-menu shadow border-0 mt-2" aria-labelledby="navbarAltas">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Clientes" asp-action="Index">
                                        <i class="bi bi-people-fill text-primary me-2"></i>Clientes
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Categorias" asp-action="Index">
                                        <i class="bi bi-tags-fill text-success me-2"></i>Categorías
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Bodegas" asp-action="Index">
                                        <i class="bi bi-building text-danger me-2"></i>Bodegas
                                    </a>
                                </li>
                                </ul>
                            </li>
                          <li class="nav-item">
                             <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="Index">Estadísticas</a>
                         </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-danger fw-bold" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                            </a>
                        </li>
                        </ul>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            VinotecaApp &copy; 2026
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
