@model VinotecaApp.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto border-danger" style="max-width: 600px;">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Eliminar Categoría</h4>
        </div>
        <div class="card-body text-center py-4">
            <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
            <h5 class="mt-3">¿Estás seguro de que querés eliminar esta categoría?</h5>
            <p class="fs-4 fw-bold text-dark mt-2 mb-1">@Model.Nombre</p>
            
            @if (Model.CategoriaPadre != null)
            {
                <p class="text-muted mb-4">(Subcategoría de: @Model.CategoriaPadre.Nombre)</p>
            }
            else
            {
                <p class="text-muted mb-4">(Categoría Principal)</p>
            }

            <p class="text-muted small">Esta acción no se puede deshacer.</p>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-danger px-4">Sí, Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>