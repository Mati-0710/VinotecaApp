@model VinotecaApp.Models.DashboardViewModel

@{
    ViewData["Title"] = "Estadísticas";
}

<h1>Estadísticas</h1>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Ventas de hoy</h5>
                <p class="card-text fs-3">@Model.TotalVentasDia.ToString("C")</p>
                <p class="card-text">@Model.CantidadVentasDia venta(s)</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Ventas del mes</h5>
                <p class="card-text fs-3">@Model.TotalVentasMes.ToString("C")</p>
                <p class="card-text">@Model.CantidadVentasMes venta(s)</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <h4>Clientes con saldo deudor</h4>
        @if (!Model.ClientesConDeuda.Any())
        {
            <p class="text-muted">No hay clientes con saldo pendiente.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Saldo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.ClientesConDeuda)
                    {
                        <tr>
                            <td>@c.NombreCompleto</td>
                            <td class="text-danger">@c.Saldo.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="col-md-6">
        <h4>Productos con stock bajo</h4>
        @if (!Model.ProductosStockBajo.Any())
        {
            <p class="text-muted">No hay productos con stock bajo.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.ProductosStockBajo)
                    {
                        <tr>
                            <td>@p.Nombre</td>
                            <td class="text-warning">@p.Stock</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>