@model VinotecaApp.Models.Cliente

@{
    ViewData["Title"] = "Detalle de Cuenta Corriente";

    // Cálculo del saldo actual del cliente
    decimal totalDebitos = Model.MovimientosCuentaCorriente?.Where(m => m.Tipo == "Debito").Sum(m => m.Monto) ?? 0;
    decimal totalCreditos = Model.MovimientosCuentaCorriente?.Where(m => m.Tipo == "Credito").Sum(m => m.Monto) ?? 0;
    decimal saldoActual = totalDebitos - totalCreditos;
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0 text-primary fw-bold"><i class="bi bi-person-lines-fill"></i> @Model.Apellido, @Model.Nombre</h3>
        <small class="text-muted">Historial de cuenta corriente</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger shadow-sm rounded-3">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success shadow-sm rounded-3">@TempData["Success"]</div>
}

<div class="row g-4 mb-5">
    <!-- TARJETA DE SALDO Y REGISTRO DE PAGO -->
    <div class="col-md-4">
        <div class="card shadow border-0 rounded-4 bg-white h-100">
            <div class="card-body p-4 d-flex flex-column">
                <h5 class="fw-bold mb-4 border-bottom pb-3 text-secondary">Estado de Cuenta</h5>

                <div class="bg-light p-4 rounded-4 text-center border shadow-sm mb-4">
                    <span class="text-muted fw-bold d-block mb-1">SALDO ACTUAL</span>
                    <h2 class="fw-bold @(saldoActual > 0 ? "text-danger" : "text-success") mb-0">
                        @saldoActual.ToString("C")
                    </h2>
                </div>

                <form asp-action="RegistrarPago" method="post" class="mt-auto">
                    <input type="hidden" name="clienteId" value="@Model.Id" />
                    
                    <label class="form-label text-secondary small fw-bold">Registrar Entrega / Pago</label>
                    <div class="input-group mb-3 shadow-sm">
                        <span class="input-group-text bg-success text-white border-success fw-bold">$</span>
                        <input type="number" step="1" name="monto" class="form-control border-success fw-bold" placeholder="Monto a pagar..." required />
                    </div>

                    <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold shadow-sm py-2">
                        <i class="bi bi-cash-coin me-1"></i> Registrar Pago
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- TABLA DE MOVIMIENTOS -->
    <div class="col-md-8">
        <div class="card shadow border-0 rounded-4 h-100 bg-white">
            <div class="card-header bg-secondary text-white rounded-top-4 py-3">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Historial de Movimientos</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light border-bottom">
                            <tr>
                                <th class="ps-4 py-3 text-secondary">Fecha</th>
                                <th class="py-3 text-secondary">Tipo</th>
                                <th class="py-3 text-secondary">Detalle</th>
                                <th class="pe-4 py-3 text-end text-secondary">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MovimientosCuentaCorriente != null && Model.MovimientosCuentaCorriente.Any())
                            {
                                @foreach (var mov in Model.MovimientosCuentaCorriente.OrderByDescending(m => m.Fecha))
                                {
                                    <tr>
                                        <td class="ps-4 text-secondary">@mov.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (mov.Tipo == "Debito")
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">Débito (Compra)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">Crédito (Pago)</span>
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @(mov.VentaId != null ? $"Venta #{mov.VentaId}" : "Entrega de dinero / Pago manual")
                                        </td>
                                        <td class="pe-4 text-end fw-bold @(mov.Tipo == "Debito" ? "text-danger" : "text-success")">
                                            @(mov.Tipo == "Debito" ? "+" : "-")@mov.Monto.ToString("C")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No hay movimientos registrados para este cliente.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>