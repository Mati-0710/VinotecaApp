@model IEnumerable<VinotecaApp.Models.Cliente>

@{
    ViewData["Title"] = "Cuentas Corrientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-wallet2"></i> Cuentas Corrientes</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Cliente</th>
                        <th>Teléfono</th>
                        <th>Estado de Cuenta</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Calculamos la deuda sumando lo que compró (Debito) y restando lo que entregó (Credito)
                        decimal totalDebito = item.MovimientosCuentaCorriente?.Where(m => m.Tipo == "Debito").Sum(m => m.Monto) ?? 0;
                        decimal totalCredito = item.MovimientosCuentaCorriente?.Where(m => m.Tipo == "Credito").Sum(m => m.Monto) ?? 0;
                        decimal deuda = totalDebito - totalCredito;

                        <tr>
                            <td class="fw-bold">@item.Apellido, @item.Nombre</td>
                            <td>@(string.IsNullOrEmpty(item.Telefono) ? "Sin teléfono" : item.Telefono)</td>
                            <td>
                                @if (deuda > 0)
                                {
                                    <span class="badge bg-danger fs-6">Debe: $@deuda.ToString("N2")</span>
                                }
                                else if (deuda < 0)
                                {
                                    <span class="badge bg-success fs-6">A favor: $@Math.Abs(deuda).ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6">Al día ($0.00)</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                    Ver Detalle / Pagar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>